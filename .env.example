# Bharat Health — Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=3000
NODE_ENV=production

# Infermedica API (Symptom Checker)
INFERMEDICA_APP_ID=your_app_id_here
INFERMEDICA_APP_KEY=your_app_key_here
INFERMEDICA_BASE_URL=https://api.infermedica.com/v3

# Google Gemini API (AI Advice & Report Analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# Sarvam AI (Multilingual Translation)
SARVAM_API_KEY=your_sarvam_api_key_here
